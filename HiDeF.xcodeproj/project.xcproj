{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "LICENSE", "target-membership": [ "HiDeF/resources" ] },
    {
      "kind": "group",
      "path": "Sources",
      "children": [
        {
          "kind": "group",
          "path": "HDF5Shim",
          "children": [
            { "path": "HiDeFHDF5.c", "target-membership": [ "HiDeF/compile-sources" ] },
            {
              "kind": "group",
              "path": "include",
              "children": [
                { "path": "HiDeFHDF5.h" },
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "HiDeF",
          "children": [
            { "path": "HiDeF-Bridging-Header.h" },
            { "path": "HiDeFApp.swift", "target-membership": [ "HiDeF/compile-sources" ] },
            { "path": "HDFDocument.swift", "target-membership": [ "HiDeF/compile-sources" ] },
            {
              "kind": "group",
              "path": "Model",
              "children": [
                { "path": "HDF5File.swift", "target-membership": [ "HiDeF/compile-sources" ] },
                { "path": "HDF5DatasetCSVExport.swift", "target-membership": [ "HiDeF/compile-sources" ] },
                { "path": "HDF5Models.swift", "target-membership": [ "HiDeF/compile-sources" ] },
              ],
            }, {
              "kind": "group",
              "path": "SwiftUI",
              "children": [
                { "path": "HDFDocumentSidebarView.swift", "target-membership": [ "HiDeF/compile-sources" ] },
              ],
            },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Resources",
      "children": [
        { "path": "AppIcon.icon", "target-membership": [ "HiDeF/resources" ] },
        { "path": "Info.plist" },
        { "path": "iOS/Info.plist" },
        { "path": "ThirdPartyLicenses.txt", "target-membership": [ "HiDeF/resources" ] },
        { "path": "Demo/demo.h5", "target-membership": [ "HiDeF/resources" ] },
      ],
    }, {
      "kind": "group",
      "path": "Vendor",
      "children": [
        {
          "kind": "group",
          "path": "Build",
          "children": [
            { "path": "HDF5.xcframework", "target-membership": [ "HiDeF/frameworks" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/HighDeF.app", "id": "00000000000000000000F018", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "HiDeF",
      "id": "00000000000000000000T001",
      "product": "Products/HighDeF.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "Resources/HiDeF.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "COPY_PHASE_STRIP[config=Debug]": "YES",
        "CURRENT_PROJECT_VERSION": "2",
        "DEAD_CODE_STRIPPING": "YES",
        "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "EXECUTABLE_NAME[sdk=iphoneos*]": "hidef",
        "EXECUTABLE_NAME[sdk=iphonesimulator*]": "hidef",
        "EXECUTABLE_NAME[sdk=xros*]": "hidef",
        "EXECUTABLE_NAME[sdk=xrsimulator*]": "hidef",
        "FRAMEWORK_SEARCH_PATHS": [
          "$(inherited)",
          "$(PROJECT_DIR)/Vendor/Build",
        ],
        "GCC_GENERATE_DEBUGGING_SYMBOLS[config=Debug]": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "HEADER_SEARCH_PATHS": [
          "$(PROJECT_DIR)/Sources/HDF5Shim/include",
          "$(PROJECT_DIR)/Vendor/Build/HDF5.xcframework/macos-arm64_x86_64/Headers",
          "$(PROJECT_DIR)/Vendor/Build/HDF5.xcframework/ios-arm64/Headers",
          "$(PROJECT_DIR)/Vendor/Build/HDF5.xcframework/ios-arm64_x86_64-simulator/Headers",
          "$(PROJECT_DIR)/Vendor/Build/HDF5.xcframework/xros-arm64/Headers",
          "$(PROJECT_DIR)/Vendor/Build/HDF5.xcframework/xros-arm64_x86_64-simulator/Headers",
        ],
        "INFOPLIST_FILE": "Resources/Info.plist",
        "INFOPLIST_FILE[sdk=iphoneos*]": "Resources/iOS/Info.plist",
        "INFOPLIST_FILE[sdk=iphonesimulator*]": "Resources/iOS/Info.plist",
        "INFOPLIST_FILE[sdk=xros*]": "Resources/iOS/Info.plist",
        "INFOPLIST_FILE[sdk=xrsimulator*]": "Resources/iOS/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "HighDeF",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphoneos*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphonesimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xros*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xrsimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.1",
        "OTHER_CFLAGS": [
          "$(inherited)",
          "-ffile-prefix-map=$(PROJECT_DIR)=.",
          "-fdebug-prefix-map=$(PROJECT_DIR)=.",
        ],
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-lz",
        ],
        "OTHER_SWIFT_FLAGS": "$(inherited) -debug-prefix-map $(PROJECT_DIR)=.",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.app.hidef",
        "PRODUCT_MODULE_NAME": "hidef",
        "PRODUCT_NAME": "HighDeF",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_OBJC_BRIDGING_HEADER": "Sources/HiDeF/HiDeF-Bridging-Header.h",
        "SWIFT_SERIALIZE_DEBUGGING_OPTIONS": "NO",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "XROS_DEPLOYMENT_TARGET": "26.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_C_LANGUAGE_STANDARD": "gnu17",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "257KW9ZJFP",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
